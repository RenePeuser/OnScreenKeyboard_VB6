<Window x:Class="OnScreenKeyboard_VB6.Controls.Numpad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:WpfKb.Controls;assembly=WpfKb"
        Title="Numpad" Height="362" Width="318" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <my:OnScreenKeypad Height="230" HorizontalAlignment="Stretch" Margin="8" Name="_numpad" VerticalAlignment="Stretch" Grid.Row="1" />
        <TextBox Text="{Binding Path=UserText}" HorizontalAlignment="Stretch" Margin="8" Name="_textBox" VerticalAlignment="Center" FontSize="28" />
    </Grid>
</Window>